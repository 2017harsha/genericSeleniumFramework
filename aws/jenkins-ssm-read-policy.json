{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSeleniumFrameworkProdParams",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:ap-south-1:<AWS_ACCOUNT_ID>:parameter/selenium-framework/prod/*"
    },
    {
      "Sid": "DecryptSecureStringWithDefaultKey",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.ap-south-1.amazonaws.com"
        }
      }
    }
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Full regression suite.
  parallel / thread-count here are defaults; -Dparallel and -Dthreads (Jenkins parameters) override them.
  Listeners are auto-registered via META-INF/services, so none are declared here.
-->
<suite name="Regression Suite" parallel="methods" thread-count="3" data-provider-thread-count="3" verbose="1">
    <test name="XPath Practice Page - Regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <packages>
            <package name="com.qa.tests"/>
        </packages>
    </test>
</suite>
